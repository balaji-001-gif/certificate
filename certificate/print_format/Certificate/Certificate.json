{
  "align_labels_right": 0,
  "custom_format": 1,
  "default_print_language": "English",
  "disabled": 0,
  "doc_type": "Certificate",
  "doctype": "Print Format",
  "font": "Default",
  "html": "<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link href=\"https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,600;0,700;1,400;1,600&family=DM+Sans:wght@300;400;500&display=swap\" rel=\"stylesheet\">\n<style>\n:root{--ink:#0f0f0f;--gold:#b8962e;--gold-light:#d4b86a;--cream:#faf8f3;--border:#c8b98a;--muted:#6b6455}\n*{box-sizing:border-box;margin:0;padding:0}\n.cert-page{width:100%;min-height:680px;background:var(--cream);font-family:\"DM Sans\",sans-serif;color:var(--ink)}\n.cert-frame{margin:18px;border:2px solid var(--gold);position:relative}\n.cert-frame::before{content:\"\";position:absolute;inset:5px;border:1px solid var(--gold-light);pointer-events:none;z-index:0}\n.corner{position:absolute;width:28px;height:28px;border-color:var(--gold);border-style:solid;z-index:2}\n.corner.tl{top:-2px;left:-2px;border-width:3px 0 0 3px}.corner.tr{top:-2px;right:-2px;border-width:3px 3px 0 0}\n.corner.bl{bottom:-2px;left:-2px;border-width:0 0 3px 3px}.corner.br{bottom:-2px;right:-2px;border-width:0 3px 3px 0}\n.cert-inner{position:relative;z-index:1;padding:36px 48px}\n.cert-top{text-align:center;margin-bottom:24px;padding-bottom:20px;border-bottom:1px solid var(--border)}\n.org-name{font-size:10px;font-weight:500;letter-spacing:.2em;text-transform:uppercase;color:var(--gold);margin-bottom:8px}\n.cert-headline{font-family:\"Cormorant Garamond\",serif;font-size:40px;font-weight:700;letter-spacing:.04em;line-height:1;margin-bottom:6px}\n.cert-type-label{font-size:10px;letter-spacing:.18em;text-transform:uppercase;color:var(--muted)}\n.cert-body{text-align:center;margin-bottom:24px}\n.presented-to{font-size:11px;letter-spacing:.14em;text-transform:uppercase;color:var(--muted);margin-bottom:8px}\n.recipient-name{font-family:\"Cormorant Garamond\",serif;font-size:36px;font-weight:600;font-style:italic;margin-bottom:14px;line-height:1.1}\n.cert-desc-text{font-size:12px;color:var(--muted);line-height:1.7;max-width:480px;margin:0 auto 16px}\n.cert-title-main{font-family:\"Cormorant Garamond\",serif;font-size:20px;font-weight:600}\n.gold-divider{display:flex;align-items:center;gap:10px;margin:16px auto;max-width:280px}\n.gold-divider::before,.gold-divider::after{content:\"\";flex:1;height:1px;background:var(--gold)}\n.diamond{width:6px;height:6px;background:var(--gold);transform:rotate(45deg);flex-shrink:0}\n.cert-details-row{display:flex;justify-content:center;gap:40px;margin-bottom:28px;flex-wrap:wrap}\n.d-item{text-align:center}\n.d-label{font-size:9px;font-weight:500;letter-spacing:.15em;text-transform:uppercase;color:var(--muted);margin-bottom:4px}\n.d-value{font-family:\"Cormorant Garamond\",serif;font-size:14px;font-weight:600}\n.cert-footer{display:flex;justify-content:space-between;align-items:flex-end;padding-top:20px;border-top:1px solid var(--border)}\n.sig-block{text-align:center;min-width:150px}\n.sig-line{width:150px;height:1px;background:var(--ink);margin:0 auto 6px}\n.sig-name{font-family:\"Cormorant Garamond\",serif;font-size:14px;font-weight:600}\n.sig-title{font-size:9px;letter-spacing:.1em;text-transform:uppercase;color:var(--muted);margin-top:2px}\n.cert-seal-block{text-align:center;flex:1}\n.seal-circle{width:66px;height:66px;border:2px solid var(--gold);border-radius:50%;display:inline-flex;flex-direction:column;align-items:center;justify-content:center}\n.seal-text{font-size:7px;letter-spacing:.1em;text-transform:uppercase;color:var(--gold);font-weight:500;line-height:1.6;text-align:center}\n.qr-block{text-align:center}\n.qr-block img{width:86px;height:86px;display:block;margin:0 auto 5px;border:1px solid var(--border);padding:3px;background:white}\n.qr-no-img{width:86px;height:86px;border:1px solid var(--border);display:flex;align-items:center;justify-content:center;font-size:9px;color:#999;text-align:center;padding:8px;margin:0 auto 5px}\n.qr-label{font-size:8px;letter-spacing:.1em;text-transform:uppercase;color:var(--muted)}\n.qr-id{font-size:8px;color:var(--gold);font-weight:500;margin-top:2px}\n</style>\n<div class=\"cert-page\">\n<div class=\"cert-frame\">\n<div class=\"corner tl\"></div><div class=\"corner tr\"></div><div class=\"corner bl\"></div><div class=\"corner br\"></div>\n<div class=\"cert-inner\">\n<div class=\"cert-top\">\n  <div class=\"org-name\">{{ doc.issuing_authority }}</div>\n  <div class=\"cert-headline\">Certificate</div>\n  <div class=\"cert-type-label\">of {{ doc.certificate_type }}</div>\n</div>\n<div class=\"cert-body\">\n  <div class=\"presented-to\">This is to certify that</div>\n  <div class=\"recipient-name\">{{ doc.recipient_name or doc.recipient }}</div>\n  <div class=\"cert-desc-text\">has successfully completed the requirements for</div>\n  <div class=\"cert-title-main\">{{ doc.certificate_title }}</div>\n  {% if doc.description %}\n  <div class=\"gold-divider\"><div class=\"diamond\"></div></div>\n  <div class=\"cert-desc-text\">{{ doc.description | striptags }}</div>\n  {% endif %}\n</div>\n<div class=\"gold-divider\"><div class=\"diamond\"></div></div>\n<div class=\"cert-details-row\">\n  <div class=\"d-item\"><div class=\"d-label\">Issue Date</div><div class=\"d-value\">{{ frappe.utils.formatdate(doc.issue_date, \"dd MMM yyyy\") }}</div></div>\n  {% if doc.from_date and doc.to_date %}<div class=\"d-item\"><div class=\"d-label\">Duration</div><div class=\"d-value\">{{ frappe.utils.formatdate(doc.from_date, \"dd MMM yyyy\") }} \u2013 {{ frappe.utils.formatdate(doc.to_date, \"dd MMM yyyy\") }}</div></div>{% endif %}\n  {% if doc.hours %}<div class=\"d-item\"><div class=\"d-label\">Total Hours</div><div class=\"d-value\">{{ doc.hours | int }} Hrs</div></div>{% endif %}\n  {% if doc.valid_until or doc.expiry_date %}<div class=\"d-item\"><div class=\"d-label\">Valid Until</div><div class=\"d-value\">{{ frappe.utils.formatdate(doc.valid_until or doc.expiry_date, \"dd MMM yyyy\") }}</div></div>{% endif %}\n  <div class=\"d-item\"><div class=\"d-label\">Cert. No.</div><div class=\"d-value\">{{ doc.name }}</div></div>\n</div>\n<div class=\"cert-footer\">\n  <div class=\"sig-block\"><div class=\"sig-line\"></div><div class=\"sig-name\">{{ doc.issuing_authority }}</div><div class=\"sig-title\">Authorized Signatory</div></div>\n  <div class=\"cert-seal-block\"><div class=\"seal-circle\"><div class=\"seal-text\">Official<br>Seal<br>{{ frappe.utils.formatdate(doc.issue_date, \"yyyy\") }}</div></div></div>\n  <div class=\"qr-block\">\n    {% if doc.qr_code %}<img src=\"{{ doc.qr_code }}\" alt=\"QR\">{% else %}<div class=\"qr-no-img\">QR not<br>generated</div>{% endif %}\n    <div class=\"qr-label\">Scan to Verify</div>\n    <div class=\"qr-id\">{{ doc.name }}</div>\n  </div>\n</div>\n</div></div></div>",
  "idx": 0,
  "line_breaks": 0,
  "module": "Certificate",
  "name": "Certificate",
  "owner": "Administrator",
  "print_format_type": "Jinja",
  "show_section_headings": 0,
  "standard": "No"
}